# OpenAI 兼容接口（DeepSeek / 通义千问 / OpenAI / 智谱 等均可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 免 Key 测试接口（每 30 秒限 1 次；key 填 not-needed 或留空）
# LLM_BASE_URL=https://text.pollinations.ai/openai
# LLM_API_KEY=not-needed
# LLM_MODEL=openai-fast

# 本地向量模型（fastembed，首次运行自动下载，约 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 可选查询前缀；本轮评测留空（启用会改变向量排序，需要重跑评测）
EMBEDDING_QUERY_PREFIX=
# 国内网络直连 HuggingFace 超时时使用镜像；海外网络可删掉这一行
HF_ENDPOINT=https://hf-mirror.com
# 可选：已经离线下载好的 ONNX 模型目录（目录内需有 model_optimized.onnx
# 和 tokenizer*.json）。留空时使用 fastembed 默认缓存。
# EMBEDDING_MODEL_PATH=.models/bge-small-zh-v1.5
# FASTEMBED_CACHE_DIR=.cache/fastembed

# 检索与切分（作者用 8 题实验比较后选择 300 字 / 50 字重叠）
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4

# “我不知道”判定阈值
# 向量检索：Top-1 余弦相似度低于该值直接拒答（当前测试语料校准值，换语料后请重测）
VECTOR_MIN_SCORE=0.40
# BM25：查询词在 Top-K 结果中的覆盖率低于该值直接拒答（当前测试语料校准值）
BM25_MIN_COVERAGE=0.30
# 可选第三层：问时间类问题时，要求「事件词 + 日期」出现在同一片段，否则拒答。
# 针对 q17（把作业截止日答成考试日期）实现，默认关闭以保持已评测结果有效；
# 开启会改变 20 题指标，需要重跑 eval 后再写进报告。
STRICT_SLOT_CHECK=0

LLM_TEMPERATURE=0
